{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],

  "labels": ["dependencies"],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "description": "Hugo is 0.x: elke minor kan templates breken. Los houden van de Actions-groep zodat de testsite-deploy op de PR gericht te controleren is.",
      "matchDepNames": ["gohugoio/hugo"],
      "addLabels": ["needs-testsite-check"]
    }
  ],

  "customManagers": [
    {
      "description": "Pikt '# renovate: datasource=X depName=Y [versioning=Z]' op, gevolgd door een 'sleutel: waarde'-regel in een workflow.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+[\\w.-]+:\\s*[\"']?(?<currentValue>[^\"'\\s#]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.html?$/"],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>[^@/]+)@(?<currentValue>[0-9][^/\"'\\s]*)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ]
}
