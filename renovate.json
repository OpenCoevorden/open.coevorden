{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],

  "labels": ["dependencies"],

  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    }
  ],

  "customManagers": [
    {
      "description": "Versies achter een '# renovate:'-comment in workflow-YAML (bv. hugo-version, node-version).",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+[\\w-]+:\\s*[\"']?(?<currentValue>[^\"'\\s#]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Gepinde Pagefind-versie: 'npx pagefind@<versie>' in de deploy-workflow.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "pagefind@(?<currentValue>[0-9][^\\s\"']*)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pagefind",
      "versioningTemplate": "semver"
    },
    {
      "description": "CDN-libraries in HTML/partials, bv. cdn.jsdelivr.net/npm/<pkg>@<versie>.",
      "customType": "regex",
      "managerFilePatterns": ["/\\.html?$/"],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>[^@/]+)@(?<currentValue>[0-9][^/\"'\\s]*)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ]
}
